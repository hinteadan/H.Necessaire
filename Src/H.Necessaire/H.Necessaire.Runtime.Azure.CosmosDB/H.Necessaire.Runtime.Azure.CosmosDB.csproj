<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
	</PropertyGroup>

	<PropertyGroup>
		<NuspecFile>H.Necessaire.Runtime.Azure.CosmosDB.nuspec</NuspecFile>
		<NuspecBasePath>$(SolutionDir)H.Necessaire.Runtime.Azure.CosmosDB</NuspecBasePath>
		<NuspecProperties>configuration=$(Configuration)</NuspecProperties>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\..\LICENSE" Link="LICENSE">
			<PackagePath></PackagePath>
			<Pack>True</Pack>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\H.Necessaire.Runtime\H.Necessaire.Runtime.csproj" />
		<ProjectReference Include="..\H.Necessaire.Serialization\H.Necessaire.Serialization.csproj" />
		<ProjectReference Include="..\H.Necessaire\H.Necessaire.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="IconLogo.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Azure.Cosmos" Version="3.64.0" />
	</ItemGroup>

</Project>
