@using H.Necessaire.Runtime.UI.Razor.Abstracts
@using Microsoft.JSInterop
@inherits HRazorComponentBase
@rendermode InteractiveAuto

<button class="h-necessaire @nameof(HButton) h-btn @GetCssClassForRole() h-crs-point @(IsBusy ? "dsbl" : null) @Classes" style="@Styles" data-action-tag="@ActionTag" @onclick=TriggerClick disabled="@(IsBusy ? "disabled" : null)">
    @ChildContent
</button>

@code {
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public string ActionTag { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public UIRole Role { get; set; } = UIRole.Unspecified;

    [Parameter] public string Classes { get; set; }
    [Parameter] public string Styles { get; set; }

    async Task TriggerClick()
    {
        if (IsBusy)
            return;

        using (BusyScope())
        {
            await HSafe.Run(async () => await OnClick.InvokeAsync()).LogError(log, ActionTag.IfEmpty($"{nameof(HButton)}.TriggerClick()"));
        }
    }

    string GetCssClassForRole()
    {
        return
            Role switch
            {
                UIRole.Danger => "dngr",
                UIRole.Success => "sces",
                UIRole.Warning => "wrng",
                UIRole.Info => "info",
                UIRole.Mute => "mute",
                UIRole.Unspecified => null,
                _ => null,
            }
            ;
    }
}
