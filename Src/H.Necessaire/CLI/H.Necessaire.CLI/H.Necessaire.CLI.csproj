<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
	</PropertyGroup>

	<PropertyGroup>
		<NuspecFile>H.Necessaire.CLI.nuspec</NuspecFile>
		<NuspecBasePath>$(SolutionDir)CLI/H.Necessaire.CLI</NuspecBasePath>
		<NuspecProperties>configuration=$(Configuration)</NuspecProperties>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\..\..\LICENSE" Link="LICENSE">
			<PackagePath></PackagePath>
			<Pack>True</Pack>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="H.Versioning" Version="3.1.3" />
		<PackageReference Include="System.Runtime.Caching" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\H.Necessaire.Runtime\H.Necessaire.Runtime.csproj" />
		<ProjectReference Include="..\..\H.Necessaire.Serialization\H.Necessaire.Serialization.csproj" />
		<ProjectReference Include="..\..\H.Necessaire\H.Necessaire.csproj" />
		<ProjectReference Include="..\H.Necessaire.Runtime.CLI\H.Necessaire.Runtime.CLI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="IconLogo.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
