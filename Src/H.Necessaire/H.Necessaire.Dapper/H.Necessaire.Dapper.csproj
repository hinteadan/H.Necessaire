<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
	</PropertyGroup>

	<PropertyGroup>
		<NuspecFile>H.Necessaire.Dapper.nuspec</NuspecFile>
		<NuspecBasePath>$(SolutionDir)H.Necessaire.Dapper</NuspecBasePath>
		<NuspecProperties>configuration=$(Configuration)</NuspecProperties>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Create_KeyValueStore_Table.sql" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Create_KeyValueStore_Table.sql" />
		<EmbeddedResource Include="Create_SqliteMigration_Table.sql" />
		<EmbeddedResource Include="Create_SqlServerMigration_Table.sql" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Dapper" Version="2.1.89" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\H.Necessaire\H.Necessaire.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="IconLogo.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
